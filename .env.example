# Sarvam AI STT API Key (Saaras v3)
SARVAM_API_KEY=your_sarvam_api_key_here

# Primary LLM Generation API Settings (Gemini Flash / OpenAI-compatible adapter)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Cerebras High-Speed Backup Provider
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FALLBACK_MODEL=gemma-4-31b

# Adaption Labs AutoScientist & Adaptive Data Platform
ADAPTION_API_KEY=your_adaption_api_key_here

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Storage & Index paths
DATA_DIR=./data
INDEX_DIR=./data/indexes
PROCESSED_DIR=./data/processed

# Server Configuration
HOST=0.0.0.0
PORT=7860
